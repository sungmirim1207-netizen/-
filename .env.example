# ==============================================================================
# KeepIn Cool - Environment Variables Template (.env.example)
# 복사하여 .env 파일을 생성한 뒤 실제 키를 입력하세요. (GitHub 커밋 절대 금지)
# ==============================================================================

# [필수] 카카오 지도 자바스크립트 키 (미입력 시 내장 인터랙티브 맵으로 자동 Fallback)
VITE_KAKAO_MAP_KEY=your_kakao_javascript_key_here

# [선택] Firebase 프로젝트 설정 (미입력 시 MockStorageService로 100% 정상 작동)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# [선택] AI Vision / OCR 서비스 엔드포인트
VITE_AI_VISION_ENDPOINT=https://api.keepincool.io/v1/hygiene-inspect

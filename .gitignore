# ==============================================================================
# KeepIn Cool - Git Ignore Rules (Security & Credential Protection)
# ==============================================================================

# 1. Environment Variables & Secret API Keys (최우선 유출 방지)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# 2. Firebase & Cloud Service Account Keys / Credentials
*firebase-adminsdk*.json
*serviceAccountKey*.json
*credentials*.json
*client_secret*.json
google-services.json
GoogleService-Info.plist
kakao_api_key.txt
*.key
*.pem
*.cert
*.p12

# 3. Personal Identifiable Information (PII) & Database Dumps
*.sqlite
*.sqlite3
*.db
*.dump
*.csv
*.xlsx
/private/
/secrets/
user_data/

# 4. Dependency Directories
node_modules/
jspm_packages/
web_modules/
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/

# 5. Build Artifacts & Distribution Folders
dist/
dist-ssr/
build/
out/
.next/
.cache/
*.tsbuildinfo

# 6. Logs & Debugging Files
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 7. OS & Editor Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
